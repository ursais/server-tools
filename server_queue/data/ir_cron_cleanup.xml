<odoo>
    <record id="ir_cron_server_queue_cleanup" model="ir.cron">
        <field name="name">Cleanup Done Server Queue Jobs</field>
        <field name="model_id" ref="model_server_queue" />
        <field name="state">code</field>
        <field name="code">model.cleanup_done_jobs(days=30)</field>
        <field name="interval_number">1</field>
