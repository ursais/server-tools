<odoo>
  <record id="ir_cron_notify_failed_jobs" model="ir.cron">
    <field name="name">Notify Server Job Failures</field>
    <field name="model_id" ref="model_server_queue"/>
    <field name="state">code</field>
    <field name="code">model.notify_failed_jobs()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
  </record>
</odoo>
