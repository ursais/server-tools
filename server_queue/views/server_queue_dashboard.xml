<odoo>
  <record id="view_server_queue_pivot" model="ir.ui.view">
    <field name="name">server.queue.pivot</field>
    <field name="model">server.queue</field>
    <field name="arch" type="xml">
      <pivot string="Server Queue Analysis">
        <field name="state" type="row"/>
        <field name="model_name" type="row"/>
        <field name="attempt_count" type="measure"/>
        <field name="last_duration" type="measure"/>
        <field name="create_date" interval="day" type="col"/>
      </pivot>
    </field>
  </record>

  <record id="view_server_queue_graph" model="ir.ui.view">
    <field name="name">server.queue.graph</field>
    <field name="model">server.queue</field>
    <field name="arch" type="xml">
      <graph string="Server Queue Stats" type="bar">
        <field name="state" type="row"/>
        <field name="last_duration" type="measure"/>
        <field name="create_date" interval="day"/>
      </graph>
    </field>
  </record>

  <record id="action_server_queue_dashboard" model="ir.actions.act_window">
    <field name="name">Queue Dashboard</field>
    <field name="res_model">server.queue</field>
    <field name="view_mode">pivot,graph</field>
    <field name="view_ids" eval="[(5, 0, 0), 
        (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_server_queue_pivot')}), 
        (0, 0, {'view_mode': 'graph', 'view_id': ref('view_server_queue_graph')})]"/>
    <field name="context">{'search_default_group_by_model_name': 1, 'search_default_group_by_state': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create server jobs to see statistics here.
      </p>
    </field>
  </record>

  <menuitem id="menu_server_queue_dashboard"
            name="Dashboard"
            parent="menu_server_queue_app_root"
            action="action_server_queue_dashboard"
            sequence="0"/>
</odoo>
