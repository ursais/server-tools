<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_server_queue_group_tree" model="ir.ui.view">
        <field name="name">server.queue.group.tree</field>
        <field name="model">server.queue.group</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="default_max_retries" />
                <field name="default_delay_seconds" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <record id="view_server_queue_group_form" model="ir.ui.view">
        <field name="name">server.queue.group.form</field>
        <field name="model">server.queue.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                        <field name="color" />
                        <field name="active" />
                        <field name="default_max_retries" />
                        <field name="default_delay_seconds" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_server_queue_group_kanban" model="ir.ui.view">
        <field name="name">server.queue.group.kanban</field>
        <field name="model">server.queue.group</field>
        <field name="arch" type="xml">
            <kanban default_group_by="active">
                <field name="color" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_title">
                                <field name="name" />
                            </div>
                            <div>
                                <field name="description" />
                            </div>
                            <div class="mt-2">
                                <strong>Jobs:</strong>
                                <ul>
                                    <li>Pending: <t
                                        t-esc="record.job_ids.raw_value | selectattr('state', 'equalto', 'pending') | list | length"
                                    /></li>
                                    <li>Retry: <t
                                        t-esc="record.job_ids.raw_value | selectattr('state', 'equalto', 'retry') | list | length"
                                    /></li>
                                    <li>Failed: <t
                                        t-esc="record.job_ids.raw_value | selectattr('state', 'equalto', 'failed') | list | length"
                                    /></li>
                                    <li>Done: <t
                                        t-esc="record.job_ids.raw_value | selectattr('state', 'equalto', 'done') | list | length"
                                    /></li>
                                </ul>
                            </div>
                            <div class="mt-2">
                                <button
                                    type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    t-attf-data-menu-params="model=server.queue&search_default_group_id={{ record.id.raw_value }}"
                                    t-att-data-menu-params="{'search_default_group_id': record.id.raw_value}"
                                >
                                    View Jobs
                                </button>
                                <button
                                    type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    t-attf-data-menu-params="model=server.queue&search_default_group_id={{ record.id.raw_value }}&search_default_failed=1"
                                    t-att-data-menu-params="{'search_default_group_id': record.id.raw_value, 'search_default_failed': 1}"
                                >
                                    View Failed
                                </button>
                            </div>

                            <div class="o_kanban_tags mt-2">
                                <span class="badge text-bg-info">Max Retries: <field
                                    name="default_max_retries"
                                /></span>
                                <span class="badge text-bg-secondary">Delay: <field
                                    name="default_delay_seconds"
                                />s</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_server_queue_group" model="ir.actions.act_window">
        <field name="name">Queue Groups</field>
        <field name="res_model">server.queue.group</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <menuitem
        id="menu_server_queue_group"
        name="Queue Groups"
        parent="server_queue.menu_server_queue_root"
        action="action_server_queue_group"
        sequence="30"
    />
</odoo>
