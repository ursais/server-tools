<odoo>
  <record id="group_server_queue_readonly" model="res.groups">
    <field name="name">Server Queue: Read Only</field>
    <field name="category_id" ref="base.module_category_hidden"/>
  </record>

  <record id="group_server_queue_full_access" model="res.groups">
    <field name="name">Server Queue: Manager</field>
    <field name="implied_ids" eval="[(4, ref('group_server_queue_readonly'))]"/>
    <field name="category_id" ref="base.module_category_hidden"/>
  </record>
</odoo>
